{
  "_使用说明": "四模型强制轨迹就近准备示例。调用calculate_nearest_entry(parameters)。非强制调用另包单Move版。",
  "_字段说明": {
    "command.operation": "操作名，nearest。",
    "command.trajectory_run": "本包为true，强制轨迹按原曲线帧准备。",
    "command.reverse": "false正向，true反向。反向仍传原曲线帧。",
    "command.loop_count": "1单次，0按PLC约定无限循环，其他值为有限循环次数。非闭合动作按原规则改为单次。",
    "command.loop_once": "未提供loop_count时兼容的旧字段，true单次、false循环。",
    "command.nearest_start": "true就近，false选择正向首帧或反向末帧。",
    "command.use_specified_time": "true固定到specified_time_ms，优先于nearest_start。",
    "command.specified_time_ms": "指定的原曲线整数毫秒帧，是曲线坐标。",
    "command.stopped_time_ms": "停止时记录的原曲线帧，用于定位当前原动作段。当前段有可执行点即优先在整段内找最近点，当前段全部不可执行才按方向换段。",
    "command.speed_factor": "接回正式曲线的倍率，1为100%。准备V/A/D始终按最大能力求解。",
    "settings.model_type_scheme": "business使用业务编号2/3/7/9。",
    "settings.forced_coefficient_time_unit_ms": "多项式自变量单位，示例100ms。",
    "settings.coarse_step_ms": "每个原段窗口内的粗搜种子步长，整数ms。",
    "settings.fine_step_ms": "最终搜索网格步长，整数ms，不能超过coarse_step_ms。",
    "models[].plc_id": "上位机PLC路由标识字符串。",
    "models[].model_id": "逻辑模型ID，与runtime.models关联。",
    "models[].device_id": "该PLC内的设备ID，1006组包使用。",
    "models[].model_type": "2单点、3多级升降、7普通多点摆、9XY多点摆。编号不是吊点数量。",
    "models[].motor_num": "真实电机数，多点7/9须等于point_init_pos原始条数。",
    "models[].active_axes": "原曲线参与虚轴。2/3使用H，7/9可使用H/P/Y。",
    "models[].follow_axes": "需接回原曲线位置的虚轴。",
    "models[].prepare_axes": "准备允许移动的虚轴，必须包含follow_axes。",
    "models[].max_motor_velocity": "每根真实电机的最大速度，mm/s。",
    "models[].max_velocity_HPY": "真实虚轴最大速度，H为mm/s，P/Y为度/s。",
    "models[].max_acceleration_HPY": "真实虚轴最大加速度，H为mm/s²，P/Y为度/s²。",
    "models[].max_deceleration_HPY": "真实虚轴最大减速度。强制准备PLC采用A=D，取两者较小上限。",
    "models[].default_velocity_HPY": "兼容的默认速度，不能高于对应max，准备仍使用max。",
    "models[].default_acceleration_HPY": "兼容的默认加速度，不能高于对应max。",
    "models[].default_deceleration_HPY": "兼容的默认减速度，不能高于对应max。",
    "models[].min_position_HPY": "虚轴行程下限，H为mm，P/Y为度。",
    "models[].max_position_HPY": "虚轴行程上限，H为mm，P/Y为度。",
    "models[].Baseheight1": "7/9的第一基准高度，mm，须与Baseheight2恰有一项为正、另一项为0。可放在geometry对象中。",
    "models[].Baseheight2": "7/9的第二基准高度，mm。",
    "models[].maxheight": "7/9正解的最大高度参数，mm。",
    "models[].point_init_pos": "7/9吊点列表，每点[x,y]或[x,y,z]，mm，保留全部吊点及真实电机顺序。",
    "models[].betainit": "普通多点初始方向角，度。XY必须为0。",
    "models[].segments": "顶层原动作段，保留原关键帧之间的段边界。",
    "models[].segments[].segment_id": "该模型内的原动作段ID。",
    "models[].segments[].start_frame": "原动作段起始整数毫秒帧。",
    "models[].segments[].end_frame": "原动作段结束整数毫秒帧，必须大于start_frame。",
    "models[].segments[].start_HPY": "原动作段起始位置，须与系数一致。",
    "models[].segments[].target_HPY": "原动作段结束位置，须与系数一致。",
    "models[].segments[].coefficient_segments": "原动作段内的系数阶段，可省略并在segments直接填写a至f。阶段须连续覆盖该原段。",
    "models[].segments[].a": "q(u)=a+b*u+c*u²+d*u³+e*u⁴+f*u⁵，u=(帧-start_frame)/系数时间单位，a为HPY三项常数。",
    "models[].segments[].b": "位置一次项HPY系数。",
    "models[].segments[].c": "位置二次项HPY系数。",
    "models[].segments[].d": "位置三次项HPY系数。",
    "models[].segments[].e": "位置四次项HPY系数。",
    "models[].segments[].f": "位置五次项HPY系数。",
    "models[].segments[].velocity_HPY": "共用数据结构保留的原段速度参数，强制曲线位置由a至f确定。",
    "models[].segments[].acceleration_HPY": "共用结构保留的原段加速度参数。",
    "models[].segments[].deceleration_HPY": "共用结构保留的原段减速度参数。",
    "runtime.elapsed_ms": "保留的运行累计时间，准备时示例为0。",
    "runtime.models[].model_id": "对应静态models的模型ID。",
    "runtime.models[].plc_id": "对应静态models的PLC路由。",
    "runtime.models[].device_id": "对应静态models的设备ID。",
    "runtime.models[].position_HPY": "停稳后的真实位置。普通7为[高度,倾角,方向角]，XY9为[高度,X倾角,Y倾角]。",
    "runtime.models[].velocity_HPY": "停稳反馈速度，当前准备要求三项为0。",
    "runtime.models[].standstill": "确认已经停稳。"
