{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "monitoryuezhong",
  "asar": false,
  "npmRebuild": false,
  "electronDownload": {
    "mirror": "https://npmmirror.com/mirrors/electron/"
  },
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "dist-electron",
    "dist"
  ],
  "extraFiles": [
    {
      "from": "Configs",
      "to": "Configs",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "Runtime",
      "to": "Runtime",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "AiAgent",
      "to": "AiAgent",
      "filter": [
        "**/*"
      ]
    }
  ],
  "mac": {
    "artifactName": "${productName}_${version}.${ext}",
    "target": [
      "dmg",
      "zip"
    ]
  },
  "win": {
    "icon": "public/favicon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "${productName}_${version}.${ext}",
    "extraFiles": [
      {
        "from": "YXZ.exe",
        "to": "YXZ.exe"
      }
    ]
  },
  "nsis": {
    "include": "build/installer.nsh",
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "installerIcon": "public/favicon.ico",
    "uninstallerIcon": "public/favicon.ico",
    "installerHeaderIcon": "public/favicon.ico"
  },
  "linux": {
    "executableName": "yzapp",
    "icon": "public/favicon.ico",
    "category": "Utility",
    "target": [
      "deb"
    ],
    "extraFiles": [
      {
        "from": "YXZ",
        "to": "YXZ"
      }
    ],
    "extraResources": [
      {
        "from": "build/linux/yz-install-update",
        "to": "linux/yz-install-update"
      },
      {
        "from": "build/linux/verify-update.cjs",
        "to": "linux/verify-update.cjs"
      },
      {
        "from": "shared/update/signing-key.ts",
        "to": "linux/signing-key.ts"
      }
    ]
  },
  "deb": {
    "afterInstall": "build/linux/after-install.tpl",
    "fpm": [
      "build/linux/yzapp.install-update.policy=/usr/share/polkit-1/actions/yzapp.install-update.policy"
    ],
    "recommends": [
      "pkexec | policykit-1",
      "libappindicator3-1"
    ]
  }
}
