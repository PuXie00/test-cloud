{
  "name": "yzapp",
  "productName": "yzapp",
  "version": "1.0.0",
  "main": "dist-electron/main/index.js",
  "description": "岳中出品，必属精品",
  "author": "岳中 <yuezhong@yuezhong.com>",
  "private": true,
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:7777/"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder",
    "build:win:dev": "set BUILD_MODE=debug&& vite build && electron-builder --config electron-builder.dev.json",
    "build:linux:appimage": "vite build && electron-builder --linux AppImage",
    "build:linux:deb": "vite build && electron-builder --linux deb",
    "build:linux:rpm": "vite build && electron-builder --linux rpm",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "pretest": "vite build --mode=test",
    "test": "vitest run"
  },
  "dependencies": {
    "archiver": "^8.0.0",
